	)
	(text "Float High is closed when the internal tank is full (Normally Open)\nFloat Low is closes when the internal tank is empty (Normally Closed)"
		(exclude_from_sim no)
		(at 50.8 101.092 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "42a5f0a3-edd9-4da0-9bce-f692c5c72358")
	)
	(text "When active, will hit about 1.6v"
		(exclude_from_sim no)
		(at 149.606 149.098 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "6c0e8c80-ff3d-489d-981e-935b1591d8bc")
	)
	(text "Be careful how you source 12V here!!!\nSay, using a buck converter your\n5V powersource will backfeed from\nthe arduino when the machine is unplugged\nyou will probably get Welder's Flash\nfrom the light if you try to inspect it\n(ask me how I know)"
		(exclude_from_sim no)
		(at 258.826 100.076 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "87c06407-fc7a-4758-8578-b2f9a41a1d82")
